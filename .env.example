# Required for the protected /api/scan/ and /api/execute/ endpoints.
STOCKBOT_API_KEY=replace-with-a-long-random-secret

# Set the same value in frontend/.env.local only if the browser must call /api/scan/.
# VITE_STOCKBOT_API_KEY=replace-with-a-long-random-secret

# paper is safe for local testing; live requires valid broker credentials.
TRADING_MODE=paper
