# ==========================================
# StockBot Production Environment Configuration
# ==========================================

# Trading Mode: paper | live
TRADING_MODE=paper
STOCKBOT_API_KEY=replace-with-a-long-random-secret

# Django Security & Production
DJANGO_SECRET_KEY=generate-a-strong-random-50-character-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL Algo_Bot_db with SQLite fallback)
DB_ENGINE=sqlite
POSTGRES_DB=Algo_Bot_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Angel One SmartAPI Credentials
ANGELONE_API_KEY=your_angel_api_key
ANGELONE_CLIENT_ID=your_client_id
ANGELONE_PASSWORD=your_password_or_pin
ANGELONE_TOTP_SECRET=your_totp_secret_key

# Telegram Real-Time Alerts
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# WhatsApp (CallMeBot) Alerts
WHATSAPP_ENABLED=false
WHATSAPP_PHONE=your_phone_with_country_code
WHATSAPP_API_KEY=your_callmebot_api_key

# ==========================================
# AI Assistant (Groq / OpenAI-Compatible LLM)
# ==========================================
# Get your free Groq API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1
AI_REQUEST_TIMEOUT=20
